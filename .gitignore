# IDE
.idea/

# Private (backup-tool)
scripts/backup-tool/backup.conf
scripts/backup-tool/backup.conf.bak
scripts/backup-tool/backup.toml

# Python の再生成物 (uv の仮想環境・bytecode・各種ツールキャッシュ)
# ツールごとにパスを列挙するとツール追加時の追記漏れで生成物が tracked になるため、
# パターンで畳んで場所に依存させない。
**/.venv/
**/__pycache__/
**/.ruff_cache/
**/.mypy_cache/
**/.pytest_cache/
**/.coverage

# Logs
*.log

# Claude
**/.claude/settings.local.json
**/.claude/plans/

# Private (defense-in-depth: 実体は $HOME 側だが repo への誤コミット防止)
**/.gitconfig.private
*.env

# 一時作業ファイル (scratch)
.cache/
tmp/

# 他のリポジトリから届くフィードバックの受け口。私的なリポジトリの内容を含みうるので
# 追跡しない。告知と処理の手順は home/.claude/hooks/feedbacks-box.py が持つ。
docs/.feedbacks-box/

# superpowers の作業領域。subagent-driven-development の workspace は自身で .gitignore を
# 生成するが brainstorming の visual companion (.superpowers/brainstorm/) は生成しないため、
# 前者を消すと後者が git status に出る。ここで両方まとめて隠す。
.superpowers/
