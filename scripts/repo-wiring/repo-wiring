#!/usr/bin/env bash
# =============================================================================
# 運用指示の取り付け。1 リポジトリへ .hidari/ と private-ops の symlink を用意する。
#
# 追跡下のファイルは一切触らない。書くのは .git/info/exclude と追跡外の symlink だけで、
# コミットを要さない。並行して別のセッションが作業していても git 上で衝突しない。
# =============================================================================

set -euo pipefail

usage() {
    echo "repo-wiring: 使い方: repo-wiring [--ops <path>] <repo-path>" >&2
    echo "       repo-wiring --check [--ops <path>] [--list <path>]" >&2
    exit 2
}

OPS=""
TARGET=""
CHECK=false
LIST=""
while [ $# -gt 0 ]; do
    case "$1" in
        --ops) [ $# -ge 2 ] || usage; OPS="$2"; shift 2 ;;
        --check) CHECK=true; shift ;;
        --list) [ $# -ge 2 ] || usage; LIST="$2"; shift 2 ;;
        -*) usage ;;
        *) [ -z "$TARGET" ] || usage; TARGET="$1"; shift ;;
    esac
done
if [ "$CHECK" = false ]; then
    [ -n "$TARGET" ] || usage
fi

fail() {
    echo "repo-wiring: $*" >&2
    exit 1
}

# --ops を省略したときは、実行しているリポジトリ自身の取り付けから導出する。
# 実体パスは PUBLIC リポへ書けないので既定値としては持てないが、実行時に自分の
# symlink を読む形ならリポジトリへ何も書かずに済む。導出できないときは空のまま
# 進まずに落ちる。空の $OPS で進むと、取り付け済みのリポが軒並み missing に見える。
if [ -z "$OPS" ]; then
    self="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$self" ] && [ -L "$self/.hidari/private-ops" ]; then
        OPS="$(readlink "$self/.hidari/private-ops")"
    else
        fail "--ops を省略できるのは、取り付け済みのリポジトリの中で実行したときだけです"
    fi
fi

# git リポジトリかどうか。取り付け側の guard と --check の両方が同じ判定をするので
# ここへ寄せる。worktree / submodule では .git がファイルになりこの式は誤判定するが、
# 誤判定の向きは「取り付けを拒む」側なので取りこぼしにはならない。1 箇所にしておけば
# 直すのも 1 箇所で済む。
is_git_repo() { [ -d "$1/.git" ]; }

# 取り付けで exclude へ書くディレクトリ。書く側・実効を確かめる側・--check で二層目の
# 存在を見る側の 3 箇所が同じ集合を使う。並べて持つと 1 箇所を足し忘れたときに
# 「書くが確かめない」という静かな穴が開く。
WIRED_DIRS=(.hidari .cache)

# 二層目 (.git/info/exclude) が入っているか。実効ではなくパターンの存在を見るのは、
# 実効だけを見ると global の excludesfile で成立してしまい、二層目の欠落を検出できない
# ためである。二層目を置いた理由が「global が効かないマシンでも守る」ことなので、
# global で ignore が成立していることは二層目がある証拠にならない。
has_second_layer() {
    local ex="$1/.git/info/exclude" dir
    for dir in "${WIRED_DIRS[@]}"; do
        grep -qxF "$dir/" "$ex" 2>/dev/null || return 1
    done
}

# 取り付け済みかどうか。-e は通常ファイルでも、まったく別の場所を指す symlink でも真に
# なるので、symlink であることと解決先が $2 と一致することの両方を見る。
# readlink の literal 比較なのは、取り付け側も ln -sfn "$OPS" で literal を書くため。
# 取り付け時と --check 時で違う表記の ops を渡せば不一致になるが、それは報告されるのが正しい。
is_wired() {
    [ -L "$1/.hidari/private-ops" ] && [ "$(readlink "$1/.hidari/private-ops")" = "$2" ]
}

[ -d "$OPS" ] || fail "運用指示の実体がありません: $OPS"

if [ "$CHECK" = true ]; then
    list="${LIST:-$OPS/repos.txt}"
    [ -f "$list" ] || fail "一覧がありません: $list"

    listed=0
    problems=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '' | '#'*) continue ;;              # 無視
        esac
        # 却下も母数に数える。listed が「判定を試みた行数」でないと、
        # 「一覧が空」と「文法違反しか無い」が同じ listed=0 になって区別できない。
        listed=$((listed + 1))
        case "$line" in
            /*)                                 # 却下 (絶対パス)
                echo "rejected: $line は \$HOME からの相対パスではありません"
                problems=$((problems + 1))
                continue
                ;;
        esac
        # 解決先ではなく一覧の綴りを出す。一覧を相対形にした理由が「出力を貼っても
        # 露出面を作らない」ことなので、報告で絶対パスへ戻すと目的を失う。
        repo="$HOME/$line"
        if ! is_git_repo "$repo"; then
            echo "vanished: $line が git リポジトリとして見つかりません"
            problems=$((problems + 1))
        elif ! is_wired "$repo" "$OPS"; then
            echo "missing: $line に運用指示が取り付けられていません"
            problems=$((problems + 1))
        elif ! has_second_layer "$repo"; then
            echo "partial: $line の exclude に二層目が入っていません"
            problems=$((problems + 1))
        else
            echo "ok: $line"
        fi
    done < "$list"

    # 問題の有無にかかわらず母数を出す。0 件と「見ていない」を区別するため。
    echo "listed=$listed problems=$problems"
    [ "$problems" -eq 0 ] || exit 1
    exit 0
fi

is_git_repo "$TARGET" || fail "git リポジトリではありません: $TARGET"

# 1. exclude へ書く。symlink を作る前に置くことで、ignore されない瞬間を作らない。
#    .cache/ も併せて書く。全数で数えると 8 リポが global の excludesfile だけに
#    依存しており、per-repo の .gitignore を持たない。global は bootstrap が配る
#    ものなので、bootstrap を通していないマシンでは効かない。
exclude="$TARGET/.git/info/exclude"
mkdir -p "$(dirname "$exclude")"
# 追記先が末尾改行を欠くと、最初の追記行が最終行と融合する。融合した既存パターンは
# ignore を失うので、利用者が意図して除外していたファイルが追跡の射程へ戻る。
# コマンド置換は末尾の改行を落とすため、最終バイトが改行なら結果は空になる。
if [ -s "$exclude" ] && [ -n "$(tail -c 1 "$exclude")" ]; then
    printf '\n' >> "$exclude"
fi
for dir in "${WIRED_DIRS[@]}"; do
    if ! grep -qxF "$dir/" "$exclude" 2>/dev/null; then
        printf '%s/\n' "$dir" >> "$exclude"
    fi
done

# 2. ignore を確かめる。配下パスで引くのは、末尾スラッシュ付きのパターンが
#    ディレクトリパスで問い合わせたときだけ実体を要求するためである。probe の名前は
#    何でもよい (末尾スラッシュのパターンは配下のどのパスにも一致する。実測で確認)。
for dir in "${WIRED_DIRS[@]}"; do
    if ! git -C "$TARGET" check-ignore -q "$dir/probe"; then
        fail "$TARGET で $dir/ が ignore されません。.gitignore の再包含を確認してください"
    fi
done

# 3. 作る。ln -sfn は既存の symlink を張り直すので、切れたリンクの修復も同じ経路で済む。
mkdir -p "$TARGET/.hidari"
ln -sfn "$OPS" "$TARGET/.hidari/private-ops"

echo "repo-wiring: $TARGET を取り付けました"
